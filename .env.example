# Copy this file to .env and fill in values.

# Set to true for pretty-printed console logs
DEBUG=false

# SQLite database path (relative to project root)
DATABASE_URL=sqlite+aiosqlite:///data/ah_tracker.db

# Comma-separated list of Albert Heijn store IDs to collect bargains from.
# Find store IDs with: python scripts/find_store.py <postal_code>
# Example: AH_STORE_IDS=2203,1812,1315
AH_STORE_IDS=

# How often the collector polls for new bargains (minutes, minimum 1)
COLLECTION_INTERVAL_MINUTES=10
