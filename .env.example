# Copy this file to .env and fill in values.

# Set to true for pretty-printed console logs
DEBUG=false

# SQLite database path (relative to project root)
DATABASE_URL=sqlite+aiosqlite:///data/ah_tracker.db

# Comma-separated list of Albert Heijn store IDs to collect bargains from.
# Find store IDs with: python scripts/find_store.py <postal_code>
# Example: AH_STORE_IDS=2203,1812,1315
AH_STORE_IDS=

# Optional: postal codes per store so the collector can look up the store
# name and address from the AH API automatically.
# Format: storeId:postalCode,storeId:postalCode
# Example: AH_STORE_POSTAL_CODES=2203:1091GH,1812:1234AB
AH_STORE_POSTAL_CODES=

# Optional: manual display name overrides per store (takes priority over API).
# Format: storeId:Name,storeId:Name
# Example: AH_STORE_NAMES=2203:AH Eerste Oosterparkstraat,1812:AH Centrum
AH_STORE_NAMES=

# How often the collector polls for new bargains (minutes, minimum 1)
COLLECTION_INTERVAL_MINUTES=10

# ── Notifications ───────────────────────────────────────────────────────────
# Push notifications via ntfy.sh (free, no account needed for public topics).
# 1. Pick a unique topic name, e.g. "ah-tracker-alongoodall-secret123"
# 2. Install the ntfy app on your phone and subscribe to the topic
# 3. Set the URL below
# Example: AH_NOTIFY_URL=https://ntfy.sh/ah-tracker-mijn-topic
AH_NOTIFY_URL=

# Optional: email via SMTP (leave AH_SMTP_HOST empty to disable)
AH_SMTP_HOST=
AH_SMTP_PORT=587
AH_SMTP_USER=
AH_SMTP_PASSWORD=
AH_SMTP_FROM=
AH_SMTP_TO=
